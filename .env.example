# Referenced throughout src/lib/square/ and STATUS.md/CLAUDE.md but never
# actually committed until now — this app runs fine on mock data with none
# of these set (see MOCK_LOCATIONS/mockCatalogForLocation in
# src/lib/square/mock.ts).

# --- Square (unset = mock/dev data everywhere, per isSquareConfigured()) ---
SQUARE_ACCESS_TOKEN=
SQUARE_ENVIRONMENT=sandbox

# The 4 launch stands, keyed by Square location ID — never a business name
# (see src/lib/square/config.ts). Slot 4 defaults to the in-seat delivery
# role; override with SQUARE_INSEAT_SLOT if that changes.
SQUARE_STAND_SLOT_1_LOCATION_ID=
SQUARE_STAND_SLOT_2_LOCATION_ID=
SQUARE_STAND_SLOT_3_LOCATION_ID=
SQUARE_STAND_SLOT_4_LOCATION_ID=
SQUARE_INSEAT_SLOT=4
SQUARE_INSEAT_SECTIONS=107,108,109,110,111
SQUARE_INSEAT_PHYSICAL_SECTION=108

# Links launch slots to the frozen 14-month historical CSV dataset for the
# heat map only (see config.ts) — never used for display or ordering.
# SQUARE_STAND_SLOT_1_HEATMAP_KEY=
# SQUARE_STAND_SLOT_2_HEATMAP_KEY=
# SQUARE_STAND_SLOT_3_HEATMAP_KEY=
# SQUARE_STAND_SLOT_4_HEATMAP_KEY=

# --- Staff control surface (section 6a) ---
# Unset = /staff is open to anyone with the URL. Dev convenience only — set
# this before the app is reachable from a real domain.
STAFF_PASSCODE=

# --- Staff open/close persistence (src/lib/staffState.ts) ---
# Unset = falls back to a JSON file on disk (.data/), fine for `npm run dev`
# only. In production / on Vercel the app REFUSES that fallback and errors
# until a store is linked: Vercel -> Storage -> Upstash Redis (Marketplace)
# -> connect to this project. Vercel injects the KV_* names below; Upstash's
# own UPSTASH_REDIS_REST_* names are accepted too.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
